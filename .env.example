# === Kroger API Credentials (REQUIRED) ===
# Get these from https://developer.kroger.com
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# === LLM Provider (REQUIRED for wizard step 1) ===
# Your Anthropic, OpenAI, or other LLM API key
LLM_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-haiku-20240307

# === Application Settings ===
# The URL users access in their browser (used for OAuth redirect URI)
BASE_URL=http://localhost:8000

# Secret key for session cookies (change this to a random string)
SESSION_SECRET_KEY=change-me-in-production

# Port to expose (default 8000)
PORT=8000
